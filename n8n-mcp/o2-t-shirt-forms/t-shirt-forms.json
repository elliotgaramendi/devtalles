      "parameters": {
        "sendTo": "elliotgaramendi@gmail.com",
        "subject": "Actualización de camisetas",
        "message": "=<!DOCTYPE html>\n<html lang=\"es\">\n\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Actualización completada</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f4f5f7; font-family: Arial, Helvetica, sans-serif;\">\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding:30px 0;\">\n    <tr>\n      <td align=\"center\">\n\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n          style=\"max-width:600px; background-color:#ffffff; border-radius:8px; border:1px solid #e0e0e0;\">\n\n          <tr>\n            <td style=\"background-color:#49129c; padding:20px; border-radius:8px 8px 0 0;\">\n              <h1 style=\"margin:0; color:#ffffff; font-size:22px; font-weight:600;\">\n                ✅ Actualización completada\n              </h1>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:24px; color:#333333; font-size:14px; line-height:1.6;\">\n\n              <p style=\"margin:0 0 12px 0;\">\n                Hola <strong>Elliot</strong>,\n              </p>\n\n              <p style=\"margin:0 0 16px 0;\">\n                El proceso de actualización de camisetas se ha completado correctamente.\n              </p>\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:16px 0;\">\n                <tr>\n                  <td style=\"background-color:#f2eef9; padding:12px; border-radius:4px; font-size:13px;\">\n                    <strong>📅 Fecha:</strong> {{$now.format('yyyy-MM-dd')}}\n                  </td>\n                </tr>\n              </table>\n\n              <h2 style=\"font-size:16px; color:#49129c; margin:24px 0 8px 0;\">\n                📦 Cambios realizados\n              </h2>\n\n              <p\n                style=\"margin:0; background-color:#fafafa; padding:12px; border:1px solid #e6e6e6; border-radius:4px; font-size:13px;\">\n                {{ $('Reduce inventory').item.json.inventory.map(item => item.Size).join(', ') }}\n              </p>\n\n              <h2 style=\"font-size:16px; color:#49129c; margin:24px 0 8px 0;\">\n                👤 Personas afectadas\n              </h2>\n\n              <p\n                style=\"margin:0; background-color:#fafafa; padding:12px; border:1px solid #e6e6e6; border-radius:4px; font-size:13px;\">\n                {{ $('Reduce inventory').item.json.orders.map(item => item['First name and last name']).join(', ') }}\n              </p>\n\n              <p style=\"margin:24px 0 0 0;\">\n                Gracias por tu atención.<br>\n                <strong>Equipo de Inventario</strong>\n              </p>\n\n            </td>\n          </tr>\n\n          <tr>\n            <td\n              style=\"background-color:#f4f5f7; padding:12px; text-align:center; font-size:11px; color:#777777; border-radius:0 0 8px 8px;\">\n              Este es un correo automático, por favor no respondas.\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n\n</html>\n",
