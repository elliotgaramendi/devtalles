@port = {{$dotenv PORT}}
@baseUrl = http://localhost:{{port}}/api/v2

### Seed the first 500 Pokémon from PokéAPI
POST {{baseUrl}}/seed

### Find the first 10 Pokémon using the default pagination
GET {{baseUrl}}/pokemon

### Find the second page with a custom limit
GET {{baseUrl}}/pokemon?page=2&limit=20

### Filter Pokémon by name
GET {{baseUrl}}/pokemon?name=bulbasaur

### Filter Pokémon by Pokédex number
GET {{baseUrl}}/pokemon?no=25

### Validate invalid pagination parameters
GET {{baseUrl}}/pokemon?page=0&limit=501

### Create a Pokémon
# @name createPokemon

POST {{baseUrl}}/pokemon
Content-Type: application/json

{
  "no": {{$timestamp}},
  "name": "pokemon-{{$timestamp}}"
}

### Find the created Pokémon by number
GET {{baseUrl}}/pokemon/{{createPokemon.response.body.$.no}}

### Find the created Pokémon by name
GET {{baseUrl}}/pokemon/{{createPokemon.response.body.$.name}}

### Find the created Pokémon by MongoDB ObjectId
GET {{baseUrl}}/pokemon/{{createPokemon.response.body.$._id}}

### Update the created Pokémon and return the persisted document
# @name updatePokemon

PATCH {{baseUrl}}/pokemon/{{createPokemon.response.body.$._id}}
Content-Type: application/json

{
  "name": "updated-{{createPokemon.response.body.$.no}}"
}

### Find the updated Pokémon by its new name
GET {{baseUrl}}/pokemon/{{updatePokemon.response.body.$.name}}

### Delete the created Pokémon and return the deleted document
# @name deletePokemon

DELETE {{baseUrl}}/pokemon/{{createPokemon.response.body.$._id}}

### Confirm that the deleted Pokémon no longer exists
GET {{baseUrl}}/pokemon/{{deletePokemon.response.body.$._id}}

### Return 404 for an unknown Pokémon
GET {{baseUrl}}/pokemon/unknown-pokemon
